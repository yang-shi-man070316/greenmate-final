# B03 天气证据配置：复制为 .env 后按需修改（.env 已被 .gitignore 排除）
# 修改后无需重启服务，下一次请求即生效

# Provider：open_meteo（默认，无需 Key，开箱即用）| qweather（和风天气，需要 Key）
WEATHER_PROVIDER=open_meteo

# 仅 qweather 需要；open_meteo 请留空
WEATHER_API_KEY=

# 单次 HTTP 请求超时（秒）
WEATHER_TIMEOUT=10

# 天气描述语言（open_meteo 的 WMO 描述映射不受影响，此参数保留给后续扩展）
WEATHER_LANGUAGE=zh

# 以下仅测试用（异常注入指向本地测试桩，正常使用请保持注释）：
# WEATHER_BASE_URL=
# WEATHER_GEOCODE_BASE_URL=
# WEATHER_QWEATHER_BASE_URL=
